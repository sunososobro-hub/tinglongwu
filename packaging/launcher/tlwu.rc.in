// Resource script of tlwu.exe; @ICON@ / @MANIFEST@ are filled in by packaging/runtime_layer.py.
// FILEVERSION / PRODUCTVERSION stay 0: build_windows.py writes the app version into the built exe (app layer).
1 ICON "@ICON@"
1 24 "@MANIFEST@"
1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "tinglongWu\0"
      VALUE "FileDescription", "tinglongWu offline speech translator\0"
      VALUE "OriginalFilename", "tlwu.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
