<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): the local subtitle history (#1311) is not part of
     cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="history" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="history" />
    </device-transfer>
</data-extraction-rules>
