    OPT_SPEAK = '  2) Speak only  Chinese -> {0} voice{1}'
    OPT_LISTEN = '  3) Listen only  {0} -> Chinese subtitles'
    OPT_LANG = '  L) Change language'
    OPT_GUI = '  G) Graphical interface (GUI)'
    OPT_UPDATE = '  U) Update now'
    OPT_AUTOUPD = '  A) Auto-update at start: {0} (press A to switch)'
    OPT_UILANG = '  I) Menu language: {0} (press I to change)'
