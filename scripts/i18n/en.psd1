# tinglongWu menu messages (Windows): English = base language. Other .psd1 files override these keys; missing keys fall back here.
# Loaded by scripts/tlwu_common.ps1 (Import-PowerShellDataFile). Values are .NET format strings: {0} {1} = arguments.
# Read-Host prompts have no trailing colon (PowerShell adds ": "). Keep this file UTF-8 with BOM.
# Add a language: copy to <lang>.psd1, translate the values, add the tag to ConvertTo-TlwuLang in tlwu_common.ps1.
@{
    LANGNAME = 'English'
    LN_auto = 'Auto (JA/EN/RU)'; LN_en = 'English'; LN_ru = 'Russian'; LN_ja = 'Japanese'
    LN_ko = 'Korean'; LN_de = 'German'; LN_fr = 'French'; LN_es = 'Spanish'
    ON = 'on'; OFF = 'off'
    UNSUPPORTED = '({0} not supported yet)'
    HEAD = 'tinglongWu    other side speaks: {0}    (press L to change)'
